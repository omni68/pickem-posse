{
  "name": "pickem-posse",
  "homepage": "https://omni68.github.io/pickem-posse",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.14.9",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "exceljs": "^4.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "npm run data:validate && react-scripts build && npm run security:build",
    "data:import": "node scripts/import-google-sheet.mjs",
    "data:normalize": "node scripts/normalize-workbook.mjs",
    "data:validate": "node scripts/validate-workbook.mjs",
    "security:build": "node scripts/check-build-secrets.mjs",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false",
    "test:parser": "node --test scripts/lib/workbook-parser.test.mjs",
    "eject": "react-scripts eject",
    "deploy": "gh-pages -d build",
    "predeploy": "npm run build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@mui/icons-material": "^5.14.9",
    "gh-pages": "^6.0.0"
  }
}
